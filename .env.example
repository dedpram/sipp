# Salin file ini menjadi `.env.local` lalu isi nilainya.
# File .env.local TIDAK ikut ke GitHub (sudah diatur di .gitignore).
#
# Nilai di bawah adalah KUNCI PUBLIK (aman berada di browser).
# Ambil dari Supabase Dashboard > Project Settings > API (atau API Keys).
# JANGAN PERNAH mengisi service_role / secret key di sini.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Proyek lama yang masih memakai "anon key" boleh mengisi baris berikut sebagai gantinya:
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Lokal: biarkan "/". GitHub Pages: "/<nama-repository>/" (diatur otomatis oleh workflow deploy).
VITE_APP_BASE_PATH=/
